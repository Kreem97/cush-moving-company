# Quote-form email delivery (optional).
# Without these, /api/quote accepts submissions and logs them server-side.

# Resend API key — https://resend.com
RESEND_API_KEY=

# Verified Resend sender address, e.g. quotes@yourdomain.com
QUOTE_FROM=

# Where quote requests are delivered. Defaults to the site email if unset.
QUOTE_INBOX=cushmovingcompany1@gmail.com
