# ── Quote-form email delivery ──────────────────────────────────────
# The ONLY variable you must set (in Vercel → Project → Settings →
# Environment Variables) for the "Get a Quote" form to send email:

RESEND_API_KEY=

#   1. Sign up at https://resend.com with the inbox that should receive
#      quote requests (e.g. cushmovingcompany1@gmail.com).
#   2. Create an API key, paste it above / into Vercel.
#   3. Done — submissions (with photos attached) arrive by email.
#
# Without this key the form still works: submissions are accepted and
# logged, just not emailed.

# ── Optional overrides (fine to leave blank) ───────────────────────

# Where quote requests are delivered. Defaults to the site email.
QUOTE_INBOX=

# The From address. Defaults to quotes@cushmovingcompany.com (our verified
# Resend domain). Override only if you need to send from a different address.
QUOTE_FROM=
